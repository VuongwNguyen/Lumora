# ════════════════════════════════════════════════════
#  Lumora BE-Moon — Environment Variables
#  Copy file này thành .env rồi điền giá trị thực
#  $ cp .env.example .env
# ════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
# Cổng server (mặc định 3030 nếu không đặt)
PORT=3030

# "development" → tắt rate limit, in stack trace
# "production"  → bật rate limit, ẩn lỗi chi tiết
NODE_ENV=development

# Danh sách origin được phép gọi API (CORS).
# Để trống = cho phép tất cả (chỉ dùng khi dev).
# Production: điền đúng domain, cách nhau bằng dấu phẩy.
# Ví dụ: https://lumora.vn,https://www.lumora.vn
ALLOWED_ORIGINS=

# Đặt true nếu server chạy sau HTTPS (bật HSTS header)
HTTPS=false

# URL công khai của app (dùng cho OG meta tags khi share link).
# BẮT BUỘC đặt đúng domain HTTPS ở production để link preview
# hiển thị đúng trên Messenger, Zalo, v.v.
# Ví dụ: https://lumora.nguyenvuongw.id.vn
APP_URL=

# ── Database ──────────────────────────────────────────
# MongoDB connection string (Atlas hoặc self-hosted)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=...

# ── Auth ──────────────────────────────────────────────
# Khóa ký JWT — PHẢI đổi trước khi deploy production.
# Tạo khóa mạnh: openssl rand -hex 32
JWT_SECRET=change_this_in_production

# Chỉ có hiệu lực khi NODE_ENV=development. Đặt false nếu muốn test khóa gói ở local.
DEV_BYPASS_LOCKS=true

# ── Email (Gmail) ─────────────────────────────────────
# Tài khoản Gmail dùng để gửi OTP và thông báo
GMAIL_USER=your@gmail.com

# App Password của Gmail (không phải mật khẩu đăng nhập).
# Tạo tại: https://myaccount.google.com/apppasswords
# Yêu cầu bật 2-Step Verification trên tài khoản Google.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── ImageKit ──────────────────────────────────────────
# Lấy từ https://imagekit.io → Developer Options
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# ── PayOS ─────────────────────────────────────────────
# Lấy từ https://payos.vn → Dashboard → API Keys
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── TMĐT / thông tin công khai ───────────────────────
# Không commit giá trị thật. Backend chỉ công khai các giá trị này qua allowlist.
OWNER_NAME=
OWNER_TAX_ID=
OWNER_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Câu đã được PO duyệt về việc giá có/không bao gồm thuế và phí áp dụng.
PAYMENT_TAX_NOTICE=
PAYMENT_TAX_NOTICE_EN=

# Các cam kết vận hành do PO duyệt, viết thành câu hoàn chỉnh bằng cả Việt/Anh.
SUPPORT_RESPONSE_NOTICE=
SUPPORT_RESPONSE_NOTICE_EN=
REFUND_TIMELINE_NOTICE=
REFUND_TIMELINE_NOTICE_EN=
REFUND_METHOD_NOTICE=
REFUND_METHOD_NOTICE_EN=

# Chỉ đặt true sau khi PO duyệt nội dung pháp lý cuối cùng.
LEGAL_CONTENT_APPROVED=false

# Mặc định phải là false. Dù đặt true, backend vẫn khóa nếu thiếu cấu hình ở trên
# hoặc thiếu credentials PayOS.
PAYMENTS_ENABLED=false

# Chỉ cấu hình URL HTTPS do Bộ Công Thương xác nhận sau khi hồ sơ được duyệt.
MOIT_NOTIFICATION_URL=

# ── Activity tracking ────────────────────────────────
# Thu thập activity end-user. Đặt false để tắt ghi DB mà không ảnh hưởng app.
ACTIVITY_TRACKING_ENABLED=true

# Ghi lỗi backend và request chậm (>2 giây). Có thể tắt độc lập khi cần giảm volume.
ACTIVITY_LOG_SERVER_ERRORS=true
ACTIVITY_LOG_SLOW_REQUESTS=true

# Số ngày giữ raw activity trước khi MongoDB TTL tự xoá.
ACTIVITY_RAW_RETENTION_DAYS=180

# ── SoundCloud ────────────────────────────────────────
# Đăng ký app tại https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
